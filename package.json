    "postcss": "^8.4.38",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "remix-development-tools": "^4.2.2",
    "remix-flat-routes": "^0.6.5",
    "remix-hono": "^0.0.16",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.4.0",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^4.2.1",
    "wrangler": "^3.65.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
