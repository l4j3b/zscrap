{
  "name": "zscrap",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "remix-routes && vite",
    "dev:r": "concurrently \"remix-routes -w\" \"vite\"",
    "build": "remix-routes && remix vite:build",
    "deploy": "wrangler pages deploy",
    "start": "wrangler pages dev ./build/client",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "tsc",
    "supabase:gen:types": "dotenv -e .env -- bash -c 'supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > database.types.ts'",
    "typegen": "wrangler types && remix-routes && npm run supabase:gen:types",
    "drizzle": "drizzle-kit",
    "drizzle:push": "npm run drizzle push",
    "drizzle:seed": "npx vite-node ./drizzle/seed.ts",
    "drizzle:functions": "npx vite-node ./drizzle/functions.ts",
    "drizzle:studio": "npm run drizzle studio",
    "prepare": "husky",
    "stripe:listen": "stripe listen --forward-to localhost:5173/webhooks/stripe"
  },
  "lint-staged": {
    "*.{js, jsx,ts,tsx}": [
      "eslint --quiet --fix"
    ],
    "*.{json,js,ts,jsx,tsx,html}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.658.1",
    "@conform-to/react": "^1.1.5",
    "@conform-to/zod": "^1.1.5",
    "@hono/sentry": "^1.2.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@remix-run/cloudflare": "2.11.2",
    "@remix-run/cloudflare-pages": "2.11.2",
    "@remix-run/react": "2.11.2",
    "@sentry/cloudflare": "^8.34.0",
    "@sentry/remix": "^8.18.0",
    "@sentry/vite-plugin": "^2.21.1",
    "@spotlightjs/spotlight": "^2.3.0",
