    "drizzle-orm": "^0.32.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "framer-motion": "^11.8.0",
    "hono": "^4.6.3",
    "input-otp": "^1.2.4",
    "isbot": "^4.1.0",
    "ky": "^1.5.0",
    "leva": "^0.9.35",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.21",
